#!/usr/bin/env bash
##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a JDK 17+ installed, then set JAVA_HOME
#   (2) Run this script from the project root
#
##############################################################################

# Attempt to set APP_HOME

loc="$0"

# Use the maximum available, or set MAX_FD == 64 in case we have a smaller limit
MAX_FD=maximum
WARN_FD_LIMIT=1024

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Collect all arguments for the java command:
#   * Default JVM options
#   * All script listed arguments (if any)
scriptArgs=$(
  "${CMD_ARGS[@]}"
)

# Collect all arguments for the java command:
#   * Default JVM options
#   * All script listed arguments (if any)
#   * The daemon-related flags
#   * And append any other flags that the user added via CLI

# Parse JVM options from environment
JVM_OPTS="${JVM_OPTS:-}"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-"

# Determine Java executable
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation." 1
    fi
else
    JAVACMD=java
fi

# Increase the number of file descriptors if we can.
if [ "$WARN_FD_LIMIT" -gt 0 ]; then
    # get the soft limit for fd and raise it up from there
    ulimit -n 4096 2>/dev/null || WARN_FD_LIMIT=ulimit -Sn 2>/dev/null
fi

# Switch to CLASSPATH mode on any known JVM bug
for jvm_opt_args in $DEFAULT_JVM_OPTS $JVM_OPTS
do
    case $jvm_opt_args in
    - classpath=* | --classpath=* | --class-path=*)
        CLASSPATH=$jvm_opt_args
        ;;
    esac
done

# Collect all arguments for the java command:
#   * Default JVM options
#   * All script listed arguments (if any)
#   * The daemon-related flags
#   * And append any other flags that the user added via CLI
JAVACMD_ARGS=$DEFAULT_JVM_OPTS $JVM_OPTS $CLASSPATH
eval "exec \"\$JAVACMD\" $JAVACMD_ARGS -classpath \"\$CLASSPATH\" org.gradle.launcher.GradleMain \"\${scriptArgs[@]}\""